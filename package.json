{
   "name": "moon-bot",
   "version": "5.0-beta",
   "description": "Simple Whatsapp Bot",
   "keywords": [
      "whatsapp-bot",
      "wabot"
   ],
   "homepage": "https://github.com/znanx/moon-bot#readme",
   "bugs": {
      "url": "https://github.com/znanx/moon-bot/issues"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/znanx/moon-bot.git"
   },
   "license": "MIT",
   "author": "znanx",
   "main": "index.js",
   "engines": {
      "node": ">= 22.x"
   },
   "directories": {
      "lib": "lib"
   },
   "scripts": {
      "start": "node index.js --max-old-space-size=1024",
      "pm2": "pm2 start index.js --name moon-bot --max-memory-restart 1G -- --max-old-space-size=1024",
      "server": "node index.js --server",
      "postinstall": "node --input-type=module -e \"import fs from 'node:fs';const p='node_modules/@whiskeysockets/baileys/lib/Socket/messages-send.js';let s=fs.readFileSync(p,'utf8');const a='const mediaType = getMediaType(message);',b='const mediaType = getMediaType(normalizeMessageContent(message)||message);';if(s.includes(a)){fs.writeFileSync(p,s.replace(a,b));console.log('patch ok')}else{console.log('skip')}\""
   },
   "dependencies": {
      "@whiskeysockets/baileys": "v7.0.0-rc14",
      "@znan/wabot": "github:znanx/wabot",
      "archiver": "^7.0.1",
      "cfonts": "^3.3.0",
      "express": "^4.21.2",
      "ignore": "^7.0.0",
      "node-cron": "^3.0.0",
      "yt-search": "^2.10.4"
   }
}
